# Copiar como .env para cambiar las credenciales del entorno local (opcional).
# El archivo .env NO se sube al repositorio.
DB_USER=mediconecta
DB_PASSWORD=
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=
# Obligatorias (SEC-07): cuentas de servicio del broker. WildFly publica con una y consume
# con la otra; ninguna puede hacer lo de la otra. Usar valores largos y distintos.
ARTEMIS_PUB_USER=mediconecta-publicador
ARTEMIS_PUB_PASSWORD=
ARTEMIS_CON_USER=mediconecta-consumidor
ARTEMIS_CON_PASSWORD=
MEDICONECTA_ADMIN_PASSWORD=
# Minimo 32 caracteres; vacio = se genera una al azar en cada arranque.
MEDICONECTA_JWT_SECRET=
# Obligatoria (SEC-10): clave AES-256 de los datos clinicos, 32 bytes en Base64.
# Generarla con:  openssl rand -base64 32
# Guardarla bien: si se pierde, los diagnosticos y recetas cifrados no se recuperan.
MEDICONECTA_CLAVE_DATOS=
VIDEOLLAMADAS_API_KEY=
PAGOS_API_KEY=
OBRASSOCIALES_ADMIN_KEY=
