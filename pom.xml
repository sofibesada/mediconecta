<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ar.com.mediconecta</groupId>
    <artifactId>mediconecta</artifactId>
    <version>1.0</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Analisis estatico en SonarCloud (lo corre el pipeline de GitHub Actions) -->
        <sonar.organization>sofibesada</sonar.organization>
        <sonar.projectKey>sofibesada_mediconecta</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <!-- La cobertura se mide sobre la capa de negocio (reglas del dominio, seguridad y
             traduccion de errores). Entidades, repositorios, recursos REST, MDB y clientes
             externos los ejercitan las pruebas de la API contra el sistema levantado. -->
        <sonar.coverage.exclusions>**/model/*.java,**/data/**,**/presentation/**,**/messaging/**,**/integracion/**,**/eventos/**,**/config/ApplicationConfig.java,**/config/CorsFilter.java,**/config/SeedAdmin.java,**/config/ApiError.java</sonar.coverage.exclusions>
    </properties>

    <!-- Versiones forzadas de dependencias transitivas con vulnerabilidades conocidas (SCA con
         Trivy en el CI). Las trae el SDK de Anthropic: Jackson 2.19.4 tenia CVE altas (DoS y
         ejecucion de codigo) y OpenTelemetry 1.62.0 una media. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.22.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>1.67.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- SDK oficial de Claude (Anthropic): lo usa solo el gateway de IA (ia/gateway). -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>3.3.0</version>
        </dependency>

        <!-- Pruebas de seguridad (Clase 11): corren contra el WildFly local solo si se
             pasa -Dapi.base=...; en un build normal se saltean. Ver src/test/README-seguridad.md -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.4.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas unitarias de la capa de negocio: dobles de prueba para repositorios y
             servicios, y una implementacion de JAX-RS y de JSON-B (en WildFly las pone el servidor). -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-core</artifactId>
            <version>6.2.11.Final</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse</groupId>
            <artifactId>yasson</artifactId>
            <version>3.0.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>mediconecta</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Mockito se carga como agente (lo pide el JDK 21+); @{argLine} suma el de JaCoCo -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Cobertura: el build falla si la capa de negocio baja de 80 % de lineas o
                 70 % de ramas (mismos limites que el Quality Gate). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>reporte</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>umbral</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>ar/com/mediconecta/*/business/*</include>
                                <include>ar/com/mediconecta/seguridad/*</include>
                                <include>ar/com/mediconecta/turnos/model/estado/*</include>
                                <include>ar/com/mediconecta/config/*ExceptionMapper</include>
                                <include>ar/com/mediconecta/config/Config</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Mutation testing (PIT): cambia el codigo de la capa de dominio (invierte condiciones,
                 cambia limites, borra llamadas...) y corre las pruebas: cada cambio que ninguna
                 prueba detecta es un hueco. Mismo alcance que el umbral de JaCoCo. No corre con
                 "verify": mvn test-compile org.pitest:pitest-maven:mutationCoverage
                 El build falla si el mutation score baja de 60 % (criterio de la catedra). -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.16.1</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>ar.com.mediconecta.*.business.*</param>
                        <param>ar.com.mediconecta.turnos.model.estado.*</param>
                        <param>ar.com.mediconecta.seguridad.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>ar.com.mediconecta.*</param>
                    </targetTests>
                    <!-- Las pruebas contra el sistema levantado no corren aca (necesitan Docker). -->
                    <excludedTestClasses>
                        <param>ar.com.mediconecta.integracion.*</param>
                        <param>ar.com.mediconecta.seguridad.SeguridadApiTest</param>
                    </excludedTestClasses>
                    <jvmArgs>
                        <jvmArg>-javaagent:${org.mockito:mockito-core:jar}</jvmArg>
                        <jvmArg>-Xshare:off</jvmArg>
                    </jvmArgs>
                    <threads>4</threads>
                    <mutationThreshold>60</mutationThreshold>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <version>5.1.2.Final</version>
                <configuration>
                    <hostname>localhost</hostname>
                    <port>9990</port>
                    <!-- Credenciales en ~/.m2/settings.xml bajo <server><id>wildfly-admin</id> -->
                    <id>wildfly-admin</id>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>