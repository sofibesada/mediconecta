<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>ar.com.mediconecta</groupId>
    <artifactId>mediconecta</artifactId>
    <version>1.0</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Analisis estatico en SonarCloud (lo corre el pipeline de GitHub Actions) -->
        <sonar.organization>sofibesada</sonar.organization>
        <sonar.projectKey>sofibesada_mediconecta</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <!-- La cobertura se mide sobre la capa de negocio (reglas del dominio, seguridad y
             traduccion de errores). Entidades, repositorios, recursos REST, MDB y clientes
             externos los ejercitan las pruebas de la API contra el sistema levantado. -->
        <sonar.coverage.exclusions>**/model/*.java,**/data/**,**/presentation/**,**/messaging/**,**/integracion/**,**/eventos/**,**/config/ApplicationConfig.java,**/config/CorsFilter.java,**/config/SeedAdmin.java,**/config/ApiError.java</sonar.coverage.exclusions>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- Pruebas de seguridad (Clase 11): corren contra el WildFly local solo si se
             pasa -Dapi.base=...; en un build normal se saltean. Ver src/test/README-seguridad.md -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.4.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas unitarias de la capa de negocio: dobles de prueba para repositorios y
             servicios, y una implementacion de JAX-RS y de JSON-B (en WildFly las pone el servidor). -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-core</artifactId>
            <version>6.2.11.Final</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse</groupId>
            <artifactId>yasson</artifactId>
            <version>3.0.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>mediconecta</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Mockito se carga como agente (lo pide el JDK 21+); @{argLine} suma el de JaCoCo -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Cobertura: el build falla si la capa de negocio baja de 80 % de lineas o
                 70 % de ramas (mismos limites que el Quality Gate). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>reporte</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>umbral</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>ar/com/mediconecta/*/business/*</include>
                                <include>ar/com/mediconecta/seguridad/*</include>
                                <include>ar/com/mediconecta/turnos/model/estado/*</include>
                                <include>ar/com/mediconecta/config/*ExceptionMapper</include>
                                <include>ar/com/mediconecta/config/Config</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.wildfly.plugins</groupId>
                <artifactId>wildfly-maven-plugin</artifactId>
                <version>5.1.2.Final</version>
                <configuration>
                    <hostname>localhost</hostname>
                    <port>9990</port>
                    <!-- Credenciales en ~/.m2/settings.xml bajo <server><id>wildfly-admin</id> -->
                    <id>wildfly-admin</id>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>